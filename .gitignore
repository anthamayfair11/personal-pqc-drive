
# Node.js / フロントエンドビルド成果物
node_modules/
dist/
*.log

# ストレージ領域 (暗号化済み一時ファイル) は .htaccess 以外を除外
# (.sweep.lock も storage/* に含まれて除外される)
storage/*
!storage/.htaccess

# 本番用バックエンド設定 (DB認証情報等が入る予定)
backend/config.php

# スイープのロックファイル (storage/* で除外済みだが明示)
storage/.sweep.lock

# CLI テストスクリプト (本番デプロイには含めない)
backend/test_sweep.php

# デプロイ用コマンド (SSH ユーザー名・ホスト・サーバーパスを含むため公開しない)
docs/deploy-commands.md


# OS / エディタの生成物
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
